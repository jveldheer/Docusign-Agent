# DocuSign Configuration
# Copy this file to .env and fill in your credentials

# DocuSign Account Settings
DOCUSIGN_ACCOUNT_ID=your_account_id
DOCUSIGN_USER_ID=your_user_id

# OAuth Settings (for JWT authentication)
DOCUSIGN_INTEGRATION_KEY=your_integration_key
DOCUSIGN_RSA_PRIVATE_KEY_PATH=./private.key

# Or use Access Token directly (for testing)
DOCUSIGN_ACCESS_TOKEN=your_access_token

# Environment: 'demo' or 'production'
DOCUSIGN_ENV=demo

# Base URLs (auto-configured based on DOCUSIGN_ENV)
# Demo: https://demo.docusign.net
# Production: https://www.docusign.net
