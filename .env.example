# VLV Participation Agreement - Environment Configuration
# Copy this file to .env and fill in your credentials
# NEVER commit .env to git!

# ============================================================
# DOCUSIGN CLICK CONFIGURATION
# ============================================================

# DocuSign Account ID (from Admin > Settings > Apps and Keys)
DOCUSIGN_ACCOUNT_ID=your_account_id

# DocuSign Access Token
# Get from: https://developers.docusign.com/tools/api-access-token
# Select "Click" API when generating
DOCUSIGN_ACCESS_TOKEN=your_access_token

# Clickwrap ID (created when you run npm run create-clickwrap)
DOCUSIGN_CLICKWRAP_ID=your_clickwrap_id

# Environment: 'demo' or 'production'
DOCUSIGN_ENV=demo

# ============================================================
# MIGHTY NETWORKS CONFIGURATION
# ============================================================

# Mighty Networks API Key
MIGHTY_NETWORKS_API_KEY=your_api_key

# Mighty Networks Network ID
MIGHTY_NETWORKS_NETWORK_ID=your_network_id

# ============================================================
# GMAIL CONFIGURATION
# ============================================================

# Gmail address for sending emails
GMAIL_EMAIL=your_email@gmail.com

# Gmail password or App Password
# If you have 2FA enabled, generate an App Password:
# https://myaccount.google.com/apppasswords
GMAIL_PASSWORD=your_password

# ============================================================
# OPTIONAL: JWT AUTHENTICATION (for production)
# ============================================================

# DocuSign User ID (for JWT auth)
# DOCUSIGN_USER_ID=your_user_id

# Integration Key (for JWT auth)
# DOCUSIGN_INTEGRATION_KEY=your_integration_key

# Path to RSA private key file (for JWT auth)
# DOCUSIGN_RSA_PRIVATE_KEY_PATH=./private.key
